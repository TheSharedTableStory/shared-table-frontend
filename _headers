# Render Static Site — Custom Cache Headers
# CSS/JS with version query strings are immutable; HTML must revalidate.

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: no-cache
